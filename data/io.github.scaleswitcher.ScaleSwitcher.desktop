[Desktop Entry]
Type=Application
Name=Scale Switcher
GenericName=Display scale switcher
Comment=Switch the GNOME display scale to 100% while selected games are running
Exec=/usr/bin/python3 @@PROJECT_DIR@@/scale_switcher.py
Icon=@@PROJECT_DIR@@/data/icons/hicolor/256x256/apps/io.github.scaleswitcher.ScaleSwitcher.png
Terminal=false
Categories=Utility;Settings;
Keywords=scale;display;games;lutris;
StartupNotify=true
StartupWMClass=io.github.scaleswitcher.ScaleSwitcher
DBusActivatable=false
