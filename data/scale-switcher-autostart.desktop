[Desktop Entry]
Type=Application
Name=Scale Switcher
Comment=Switch the GNOME display scale to 100% while selected games are running
Exec=/usr/bin/python3 @@PROJECT_DIR@@/scale_switcher.py --background
Icon=@@PROJECT_DIR@@/data/icons/hicolor/256x256/apps/io.github.scaleswitcher.ScaleSwitcher.png
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
StartupNotify=false
NoDisplay=true
